# Nonsecret template. The web application consumes the documented server settings.
APP_ENV=development
STORE_ID=1618
DATA_MODE=synthetic
TIMEZONE=America/New_York
POLICY_VERSION=SYNTHETIC-v0
FDA_SHORTAGES_BASE_URL=https://api.fda.gov/drug/shortages.json
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
# ANTHOPIC_API_KEY is supported as a server-only legacy spelling alias.
# Hosted mode requires both reviewer values and a trusted hostname.
PHARMACY_REVIEWER_USERNAME=
PHARMACY_REVIEWER_PASSWORD=
PHARMACY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# No database configuration while SQL/database work is deferred.
