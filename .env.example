# Nonsecret template. The web application consumes the documented server settings.
APP_ENV=development
STORE_ID=1618
DATA_MODE=synthetic
TIMEZONE=America/New_York
POLICY_VERSION=SYNTHETIC-v0
FDA_SHORTAGES_BASE_URL=https://api.fda.gov/drug/shortages.json
# Database adapter integration is pending; placeholders only, never credentials.

SUPABASE_URL=https://xrptinavijhwvydoqdni.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Backend-only PostgreSQL credential: set through secret storage, never expose to model/browser.
# Local generated value is in ignored .env.database; do not commit it.
PHARMACY_DATABASE_URL=

# Optional OpenAI-compatible chat endpoint for --model. Empty means use Anthropic if keyed.
# PHARMACY_MODEL_URL=
# PHARMACY_MODEL_KEY=
# PHARMACY_MODEL_NAME=
# Defaults to Sonnet 5.5; set this explicitly in each environment to override.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# ANTHOPIC_API_KEY is supported as a server-only legacy spelling alias.
# Hosted mode requires both reviewer values and a trusted hostname.
PHARMACY_REVIEWER_USERNAME=
PHARMACY_REVIEWER_PASSWORD=
PHARMACY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
